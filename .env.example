# auto uses Gemini when GEMINI_API_KEY is present, otherwise the explicit stub.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

DATABASE_URL=sqlite:///./opping.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_IMAGES_PER_LISTING=5
MAX_IMAGE_BYTES=10485760

